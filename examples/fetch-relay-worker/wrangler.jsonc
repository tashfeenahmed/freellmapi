{
  "name": "freellmapi-fetch-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "enable_request_signal",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "ALLOWED_UPSTREAM_HOSTS": "api.openai.com,api.groq.com,generativelanguage.googleapis.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
