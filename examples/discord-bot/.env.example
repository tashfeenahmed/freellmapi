# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: register slash commands to one server instantly (otherwise global, can take up to 1h)
DISCORD_GUILD_ID=

# --- FreeLLMAPI ---
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_KEY=freellmapi-your-unified-key
# auto | auto:fast | auto:coding | or a specific model id from GET /v1/models
FREELLMAPI_MODEL=auto

# --- Bot behaviour ---
SYSTEM_PROMPT=You are a friendly, concise assistant in a Discord server. Use Discord markdown.
# How many previous messages per channel to remember
HISTORY_LIMIT=20
# Comma-separated channel IDs where the bot replies to every message (no @mention needed)
AUTO_REPLY_CHANNELS=
