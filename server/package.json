{
  "name": "@freellmapi/server",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --pool=forks --fileParallelism=false --coverage",
    "test:migrations": "vitest run --pool=forks --fileParallelism=false src/__tests__/db/migrate/roundtrip.test.ts",
    "lint": "eslint .",
    "export-catalog": "tsx src/scripts/export-catalog.ts",
    "rotate-encryption-key": "tsx src/scripts/rotate-encryption-key.ts",
    "db:migration:up": "tsx src/db/migrate/cli.ts up",
    "db:migration:down": "tsx src/db/migrate/cli.ts down",
    "db:migration:fresh": "tsx src/db/migrate/cli.ts fresh",
    "db:migration:status": "tsx src/db/migrate/cli.ts status",
    "db:migration:create": "tsx src/db/migrate/cli.ts create"
  },
  "dependencies": {
    "@freellmapi/shared": "*",
    "ajv": "^8.20.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.0.0",
    "undici": "^6.21.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.18.0 <25.0.0",
    "npm": ">=10.0.0"
  }
}
