# ── FreeLLMAPI dashboard (for HTTP API auth) ───────────────────────────────
# Base URL of FreeLLMAPI as seen from inside the docker network.
FREEAPI_BASE_URL=http://freellmapi:3001
# Dashboard login credentials (same email/password you use to log in to the UI).
FREEAPI_EMAIL=you@example.com
FREEAPI_PASSWORD=changeme
# Docker network the FreeLLMAPI container is on. Find with: docker network ls
FREEAPI_NETWORK=freellmapi_default

# ── OpenRouter (upstream discovery + probe) ────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LABEL=OpenRouter (auto-sync)

# ── Sync behavior ───────────────────────────────────────────────────────────
# How often to run a sync pass (ms). 8h = 28800000. Handoff suggests 6–12h.
SYNC_INTERVAL_MS=28800000
# Disable a synced model only after N consecutive passes where it has vanished
# from OpenRouter's free list. It is never deleted.
DISABLE_AFTER_MISSES=3
# Set DRY_RUN=true for the first pass: it lists what WOULD be added but writes
# nothing. Flip to false once the plan looks right.
DRY_RUN=true
# Run a single pass and exit (handy for manual/cron use). Leave false for the
# long-running container.
RUN_ONCE=false
# Per-model probe timeout (ms).
PROBE_TIMEOUT_MS=30000
# Log every discovered free model id each pass (verbose).
LOG_MODELS=false
# Discover mode: also scan OTHER custom endpoints (e.g. teamorouter, sensenova)
# via FreeLLMAPI's /api/keys/custom/discover-models and register new model ids
# after a probe. Native providers (groq/cerebras/etc) are NOT touched — they
# are owned by FreeLLMAPI's catalog-sync.
DISCOVER_MODE=false
